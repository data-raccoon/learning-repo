{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-learn.local/schemas/agent-pack-v1.json",
  "title": "Portable Agent Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "name", "version", "description", "components", "entrypoints", "verification"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "kind": {"enum": ["role-pack", "workflow-pack", "operating-system"]},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "minLength": 20},
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_definitions", "skills", "workflows", "resources"],
      "properties": {
        "agent_definitions": {"$ref": "#/$defs/components"},
        "skills": {"$ref": "#/$defs/components"},
        "workflows": {"$ref": "#/$defs/components"},
        "resources": {"$ref": "#/$defs/components"}
      }
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "component"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["agent_definition", "skill", "workflow"]},
          "component": {"type": "string", "pattern": "^(agent_definition|skill|workflow):[a-z0-9]+(?:-[a-z0-9]+)*$"}
        }
      }
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "path": {"$ref": "#/$defs/path"}
        }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "argv"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "description"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "path": {"$ref": "#/$defs/path"},
          "description": {"type": "string", "minLength": 1},
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/id"}
          }
        }
      }
    }
  }
}
