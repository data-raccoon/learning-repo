{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectStart stack pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "summary", "components", "allowed_dependency_families", "forbidden_patterns", "required_artifacts", "generator", "verification_profile"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "summary": {"type": "string"},
    "components": {"type": "object", "additionalProperties": {"type": "string"}},
    "allowed_dependency_families": {"type": "array", "items": {"type": "string"}},
    "forbidden_patterns": {"type": "array", "items": {"type": "string"}},
    "required_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "notes"],
      "properties": {
        "id": {"type": "string"},
        "mode": {"enum": ["plan-only", "trusted-generator"]},
        "notes": {"type": "string"}
      }
    },
    "verification_profile": {"type": "string"}
  }
}
