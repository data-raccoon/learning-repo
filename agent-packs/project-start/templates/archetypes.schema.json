{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectStart archetype catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "archetypes"],
  "properties": {
    "schema_version": {"const": 1},
    "archetypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "use_when", "reject_when", "max_initial_modules", "defaults"],
        "properties": {
          "id": {"type": "string"},
          "summary": {"type": "string"},
          "use_when": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "reject_when": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "max_initial_modules": {"type": "integer", "minimum": 1, "maximum": 20},
          "defaults": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
