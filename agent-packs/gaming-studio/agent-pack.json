{
  "schema_version": 1,
  "id": "gaming-studio",
  "kind": "workflow-pack",
  "name": "Gaming Studio",
  "version": "1.0.0",
  "description": "Coordinate bounded game direction, creative production, engineering, and independent QA.",
  "components": {
    "agent_definitions": [
      {"id": "game-director", "path": "agent-definitions/game-director.md", "description": "Own the player promise and MVP specification.", "capabilities": ["planning", "game-design"]},
      {"id": "creative-producer", "path": "agent-definitions/creative-producer.md", "description": "Own art direction and asset provenance.", "capabilities": ["creative-production", "planning"]},
      {"id": "gameplay-engineer", "path": "agent-definitions/gameplay-engineer.md", "description": "Own implementation and developer tests.", "capabilities": ["coding", "testing"]},
      {"id": "qa-playtest", "path": "agent-definitions/qa-playtest.md", "description": "Own independent findings and release evidence.", "capabilities": ["review", "testing"]}
    ],
    "skills": [],
    "workflows": [
      {"id": "game-mvp-lifecycle", "path": "manage.py", "description": "Materialize and validate the game-production lifecycle."}
    ],
    "resources": [
      {"id": "game-contracts", "path": "templates", "description": "Brief, specification, handoff, and QA contracts."}
    ]
  },
  "entrypoints": [
    {"id": "build-game-mvp", "kind": "workflow", "component": "workflow:game-mvp-lifecycle"}
  ],
  "verification": [
    {"id": "unit-tests", "argv": ["{python}", "-m", "unittest", "discover", "-s", "agent-packs/gaming-studio/tests", "-v"]}
  ]
}
