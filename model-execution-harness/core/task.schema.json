{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-learn.local/small-context-task-v1.json",
  "title": "Small-context task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v", "id", "goal", "target", "model", "context", "write_roots", "done",
    "forbidden", "limits", "verifiers"
  ],
  "properties": {
    "v": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 1000},
    "target": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "capability", "importance"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "capability": {"type": "string", "minLength": 1},
        "importance": {"enum": ["low", "normal", "high", "critical"]}
      }
    },
    "context": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "start", "end"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "start": {"type": "integer", "minimum": 1},
          "end": {"type": "integer", "minimum": 1}
        }
      }
    },
    "write_roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_commands": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "done": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "forbidden": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_chars", "output_chars", "model_context_tokens",
        "model_output_tokens", "model_timeout_seconds", "max_tool_calls",
        "max_verifiers", "verifier_timeout_seconds"
      ],
      "properties": {
        "packet_chars": {"type": "integer", "minimum": 256, "maximum": 1000000},
        "output_chars": {"type": "integer", "minimum": 128, "maximum": 1000000},
        "model_context_tokens": {"type": "integer", "minimum": 1024, "maximum": 256000},
        "model_output_tokens": {"type": "integer", "minimum": 32, "maximum": 256000},
        "model_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "max_tool_calls": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_verifiers": {"type": "integer", "minimum": 0, "maximum": 32},
        "verifier_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "verifiers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "argv"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {"type": "string", "maxLength": 1000}
          }
        }
      }
    }
  }
}
