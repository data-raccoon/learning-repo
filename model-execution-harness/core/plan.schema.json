{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-learn.local/bounded-worker-plan-v2.json",
  "title": "Dependency-ordered bounded worker plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "completed", "tasks"],
  "properties": {
    "v": {"const": 2},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "completed": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "task.schema.json"}
    }
  }
}
