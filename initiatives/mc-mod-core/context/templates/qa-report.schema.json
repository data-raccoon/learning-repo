{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MC-Mod QA Report Schema",
  "description": "Schema for QA reports on Fabric mod implementations",
  "type": "object",
  "required": ["mod_id", "inspection_date", "inspector", "findings", "summary", "verifier_results", "coverage"],
  "additionalProperties": false,
  "properties": {
    "mod_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "The mod identifier being inspected"
    },
    "inspection_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when inspection occurred"
    },
    "inspector": {
      "type": "string",
      "description": "Identifier of the QA agent/model"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "category", "description", "evidence", "owner", "reproducible", "tested_scenario"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]+-[0-9]+$",
            "description": "Unique finding identifier (e.g., CLIENT-001, SERVER-002)"
          },
          "severity": {
            "type": "string",
            "enum": ["blocking", "critical", "major", "minor", "info"],
            "description": "Severity level of the finding"
          },
          "category": {
            "type": "string",
            "enum": [
              "correctness",
              "completeness", 
              "compatibility",
              "performance",
              "security",
              "accessibility",
              "usability",
              "documentation",
              "testing"
            ],
            "description": "Category of the finding"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "description": "Human-readable description of the finding"
          },
          "evidence": {
            "type": "string",
            "description": "Specific evidence supporting the finding (file:line, log output, etc.)"
          },
          "owner": {
            "type": "string",
            "enum": ["mod-architect", "asset-producer", "mod-engineer", "root-orchestrator"],
            "description": "Role responsible for addressing this finding"
          },
          "reproducible": {
            "type": "boolean",
            "description": "Whether the finding is reliably reproducible"
          },
          "tested_scenario": {
            "type": "string",
            "minLength": 5,
            "description": "Description of the scenario that was tested"
          },
          "stack_trace": {
            "type": "string",
            "description": "Stack trace if finding is a crash/error"
          },
          "screenshot": {
            "type": "string",
            "description": "Path to screenshot evidence if applicable"
          },
          "video": {
            "type": "string",
            "description": "Path to video evidence if applicable"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_findings", "blocking", "critical", "major", "minor", "info", "recommendation"],
      "additionalProperties": false,
      "properties": {
        "total_findings": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of findings"
        },
        "blocking": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of blocking findings"
        },
        "critical": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of critical findings"
        },
        "major": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of major findings"
        },
        "minor": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of minor findings"
        },
        "info": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of informational findings"
        },
        "recommendation": {
          "type": "string",
          "enum": ["PASS", "FAIL", "CONDITIONAL_PASS"],
          "description": "Overall recommendation"
        },
        "notes": {
          "type": "string",
          "description": "Additional notes or context for the recommendation"
        }
      }
    },
    "verifier_results": {
      "type": "array",
      "description": "Results from independent verifier execution",
      "items": {
        "type": "object",
        "required": ["verifier_id", "exit_code", "execution_time_seconds", "passed"],
        "additionalProperties": false,
        "properties": {
          "verifier_id": {
            "type": "string",
            "description": "ID of the verifier from mod-spec.json"
          },
          "exit_code": {
            "type": "integer",
            "description": "Exit code from verifier execution"
          },
          "execution_time_seconds": {
            "type": "number",
            "minimum": 0,
            "description": "Time taken to execute verifier"
          },
          "stdout": {
            "type": "string",
            "description": "Standard output from verifier"
          },
          "stderr": {
            "type": "string",
            "description": "Standard error from verifier"
          },
          "passed": {
            "type": "boolean",
            "description": "Whether the verifier passed (exit_code == 0)"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "description": "Evidence status of each numbered acceptance criterion",
      "additionalProperties": {
        "enum": ["passed", "failed", "not_tested", "not_applicable"]
      }
    }
  }
}
