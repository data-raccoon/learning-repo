{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Minecraft Mod Asset Manifest",
  "description": "Schema for tracking asset provenance in a Fabric mod",
  "type": "object",
  "required": ["schema_version", "mod_id", "assets"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Version of this schema"
    },
    "mod_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "The mod identifier"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this manifest was generated"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "category", "provenance", "placeholder", "checksum", "size_bytes", "format"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^src/(?:main|client)/resources/assets/[a-z0-9_-]+/.+\\.[a-z0-9]+$",
            "description": "Repository-relative Fabric resource file path"
          },
          "category": {
            "type": "string",
            "enum": [
              "texture",
              "block_texture",
              "item_texture",
              "entity_texture",
              "gui_texture",
              "particle_texture",
              "model",
              "block_model",
              "item_model",
              "entity_model",
              "blockstate",
              "lang",
              "sound_definition",
              "sound_file",
              "shader",
              "font",
              "animation",
              "other"
            ],
            "description": "Category of the asset"
          },
          "generator": {
            "type": "string",
            "description": "Tool or script that generated this asset (if procedural)"
          },
          "author": {
            "type": "string",
            "description": "Human author (if manually created)"
          },
          "provenance": {
            "type": "string",
            "enum": ["procedural", "placeholder", "original", "modified"],
            "description": "Origin of the asset"
          },
          "license": {
            "type": "string",
            "description": "License identifier (if not procedural/placeholder)"
          },
          "placeholder": {
            "type": "boolean",
            "description": "True if this is a placeholder asset"
          },
          "intent": {
            "type": "string",
            "description": "Intended use in the mod (block, item, entity, ui, etc.)"
          },
          "checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 checksum of the asset file"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "Size of the asset file in bytes"
          },
          "dimensions": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "integer", "minimum": 1},
            "description": "Width and height for texture assets"
          },
          "format": {
            "type": "string",
            "enum": ["PNG", "JPEG", "OGG", "JSON", "TTF", "other"],
            "description": "File format of the asset"
          }
        }
      }
    }
  }
}
