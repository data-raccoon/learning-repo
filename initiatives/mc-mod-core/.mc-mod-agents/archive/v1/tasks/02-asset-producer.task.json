{
  "v": 1,
  "id": "mana-core-asset-producer",
  "goal": "Create the approved original or procedural Fabric resource files and a complete provenance manifest.",
  "target": "initiatives/mc-mod-core",
  "model": {
    "profile": "auto",
    "capability": "coding",
    "importance": "normal"
  },
  "context": [
    {
      "path": ".mc-mod-agents/context/roles/asset-producer.md",
      "start": 1,
      "end": 10000000
    },
    {
      "path": ".mc-mod-agents/context/templates/asset-manifest.schema.json",
      "start": 1,
      "end": 10000000
    },
    {
      "path": "docs/PRODUCT.md",
      "start": 1,
      "end": 10000000
    },
    {
      "path": "docs/ARCHITECTURE.md",
      "start": 1,
      "end": 10000000
    },
    {
      "path": "docs/ACCEPTANCE.md",
      "start": 1,
      "end": 10000000
    },
    {
      "path": "mod-spec.json",
      "start": 1,
      "end": 10000000
    }
  ],
  "write_roots": [
    "docs/style-guide.md",
    "assets/asset-manifest.json",
    "src/main/resources/assets/mana-core/lang/en_us.json",
    "src/client/resources/assets/mana-core/particles/mana_flow.json",
    "src/client/resources/assets/mana-core/textures/particle/mana_particle.png"
  ],
  "done": [
    "Every declared creative artifact exists at its exact Fabric resource path.",
    "assets/asset-manifest.json records every creative artifact with provenance and SHA-256.",
    "docs/style-guide.md explains the visual and accessibility rules used."
  ],
  "forbidden": [
    "Do not edit Java, Gradle, approved design documents, mod-spec.json, or agent state.",
    "Do not download assets or use material with unclear licensing."
  ],
  "limits": {
    "packet_chars": 70000,
    "output_chars": 16000,
    "model_context_tokens": 8192,
    "model_output_tokens": 2048,
    "model_timeout_seconds": 600,
    "max_tool_calls": 16,
    "max_verifiers": 1,
    "verifier_timeout_seconds": 900
  },
  "verifiers": [
    {
      "id": "asset-contract",
      "argv": [
        "{python}",
        ".mc-mod-agents/tools/verify_assets.py"
      ]
    }
  ]
}
