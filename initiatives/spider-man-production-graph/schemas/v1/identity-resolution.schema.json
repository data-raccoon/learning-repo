{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/spg/v1/identity-resolution.schema.json",
  "title": "Identity resolution decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "entity_ids", "decision",
    "corroborating_identifiers", "rationale", "reviewed_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^identity-[a-z0-9-]+$"},
    "entity_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2, "uniqueItems": true},
    "decision": {"enum": ["merge", "do_not_merge", "unresolved"]},
    "corroborating_identifiers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "rationale": {"type": "string"},
    "reviewed_at": {"type": "string", "format": "date"}
  }
}
